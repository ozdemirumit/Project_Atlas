# Copy this file to .env and replace the value before using Docker Compose.
ATLAS_POSTGRES_PASSWORD=replace-with-a-local-development-secret
ATLAS_DEVELOPMENT_IDENTITY_ENABLED=false

# Enterprise directory authentication is disabled until a complete LDAPS profile is supplied.
ATLAS_DIRECTORY_IDENTITY_ENABLED=false
ATLAS_DIRECTORY_ENDPOINTS='["ldaps://dc01.example.internal:636"]'
ATLAS_DIRECTORY_CA_CERTIFICATE_FILE=C:/atlas/trust/enterprise-directory-ca.pem
ATLAS_DIRECTORY_USER_PRINCIPAL_TEMPLATE={username}@example.internal
ATLAS_DIRECTORY_USER_SEARCH_BASE=OU=People,DC=example,DC=internal
ATLAS_DIRECTORY_USER_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# Group mappings are a JSON array. No directory password or bind secret belongs in this file.
ATLAS_DIRECTORY_GROUP_MAPPINGS=[]

# Browser sessions use opaque credentials, an HTTP-only cookie, and a separate CSRF header.
# Production always marks the cookie Secure; timeout and concurrency values are platform-bounded.
ATLAS_SESSION_COOKIE_NAME=atlas_session
ATLAS_CSRF_COOKIE_NAME=atlas_csrf
ATLAS_CSRF_HEADER_NAME=X-CSRF-Token
ATLAS_SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
ATLAS_SESSION_IDLE_TIMEOUT_MINUTES=30
ATLAS_SESSION_MAX_PER_SUBJECT=5
