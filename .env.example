# Copy this file to .env and replace the value before running scripts/install.
# See the "Configuration" section in README.md for what each setting does.
# scripts/install reads .env itself (not the backend) to reach the PostgreSQL server it sets
# up the atlas role/database/extension on; the backend only ever reads ATLAS_DATABASE_URL.
ATLAS_POSTGRES_HOST=localhost
ATLAS_POSTGRES_PORT=5432
ATLAS_POSTGRES_PASSWORD=replace-with-a-local-development-secret
ATLAS_DEVELOPMENT_IDENTITY_ENABLED=false

# Backs the encrypted-content-at-rest store (ADR-184): document-sourced knowledge AND the
# self-built connector-credential vault (see README.md's "Going to production" section) both
# store their secret material through this one key. Left unset here (not merely empty --
# uncomment the line below only once you have a real key) because an empty value is a configured
# key, not an absent one, and would fail closed instead of falling back to development's in-memory
# store. Generate one with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing this key makes everything it encrypted permanently unrecoverable -- back it up outside
# the database.
# ATLAS_PROTECTED_CONTENT_ENCRYPTION_KEY_B64=

# Local/on-prem LLM gateway for governed model invocation (an OpenAI-compatible /v1 endpoint --
# see atlas.modules.ai.adapters.openai_compatible.OpenAICompatibleTransport). All three of
# ATLAS_LOCAL_MODEL_BASE_URL/_ID/_READER_TOKEN are required together once enabled -- the backend
# refuses to start otherwise. Never put the real reader token in this file; set it only in your
# own untracked .env.
ATLAS_LOCAL_MODEL_ENABLED=false
ATLAS_LOCAL_MODEL_BASE_URL=https://your-llm-gateway.example.internal/v1
ATLAS_LOCAL_MODEL_ID=your-model-id
ATLAS_LOCAL_MODEL_READER_TOKEN=replace-with-your-real-bearer-token

# Enterprise directory authentication is disabled until a complete LDAPS profile is supplied.
ATLAS_DIRECTORY_IDENTITY_ENABLED=false
ATLAS_DIRECTORY_ENDPOINTS=["ldaps://dc01.example.internal:636"]
ATLAS_DIRECTORY_CA_CERTIFICATE_FILE=C:/atlas/trust/enterprise-directory-ca.pem
ATLAS_DIRECTORY_USER_PRINCIPAL_TEMPLATE={username}@example.internal
ATLAS_DIRECTORY_USER_SEARCH_BASE=OU=People,DC=example,DC=internal
ATLAS_DIRECTORY_USER_SEARCH_FILTER=(&(objectClass=user)(sAMAccountName={username}))
# Group mappings are a JSON array. No directory password or bind secret belongs in this file.
ATLAS_DIRECTORY_GROUP_MAPPINGS=[]

# Secret-free deployment credential-assignment metadata is a JSON array. Passwords, tokens,
# private keys, certificates, vault paths and retrievable secret references are prohibited.
ATLAS_WORKFLOW_TRANSPORT_CREDENTIAL_ASSIGNMENTS=[]

# Browser sessions use opaque credentials, an HTTP-only cookie, and a separate CSRF header.
# Production always marks the cookie Secure; timeout and concurrency values are platform-bounded.
ATLAS_SESSION_COOKIE_NAME=atlas_session
ATLAS_CSRF_COOKIE_NAME=atlas_csrf
ATLAS_CSRF_HEADER_NAME=X-CSRF-Token
ATLAS_SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
ATLAS_SESSION_IDLE_TIMEOUT_MINUTES=30
ATLAS_SESSION_MAX_PER_SUBJECT=5
ATLAS_API_CREDENTIAL_MAX_LIFETIME_MINUTES=60
ATLAS_API_CREDENTIAL_MAX_ACTIVE_PER_SUBJECT=10
