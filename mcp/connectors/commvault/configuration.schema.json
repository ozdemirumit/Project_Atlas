{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-atlas:connector:commvault:configuration:0.1.0",
  "title": "Commvault CommServe (REST API) connector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint_host",
    "endpoint_port",
    "certificate_trust_reference_id",
    "credential_reference_id"
  ],
  "properties": {
    "endpoint_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
    },
    "endpoint_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 443,
      "description": "443 is Commvault's confirmed default HTTPS Web Server / Web Console port for the REST API."
    },
    "certificate_trust_reference_id": {
      "type": "string",
      "pattern": "^trust\\.[a-z0-9_.:-]{3,127}$"
    },
    "credential_reference_id": {
      "type": "string",
      "pattern": "^secret\\.[a-z0-9_.:-]{3,127}$",
      "description": "References a username:password pair, not a pre-built Authorization header -- Commvault's real REST API is session-based (POST webservice/Login). See source-provenance.json."
    }
  }
}
