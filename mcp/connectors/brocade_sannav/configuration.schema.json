{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-atlas:connector:brocade-sannav:configuration:0.1.0",
  "title": "Brocade SANnav Management Portal connector configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpoint_host",
    "endpoint_port",
    "certificate_trust_reference_id",
    "credential_reference_id",
    "allowed_fabric_wwns"
  ],
  "properties": {
    "endpoint_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
    },
    "endpoint_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 443
    },
    "certificate_trust_reference_id": {
      "type": "string",
      "pattern": "^trust\\.[a-z0-9_.:-]{3,127}$"
    },
    "credential_reference_id": {
      "type": "string",
      "pattern": "^secret\\.[a-z0-9_.:-]{3,127}$"
    },
    "allowed_fabric_wwns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f:]{8,64}$"
      }
    }
  }
}
